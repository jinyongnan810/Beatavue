      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beatavue reads heart rate and HRV (SDNN) to show your history and mirrored workout readings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数と心拍変動（SDNN）を読み取り、履歴とWatchの測定値を表示します。"
          }
