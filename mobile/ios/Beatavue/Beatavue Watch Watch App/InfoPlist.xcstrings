    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beatavue reads heart rate during a workout you start to display it on your Watch and iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始したワークアウトの心拍数を読み取り、WatchとiPhoneに表示します。"
