          "stringUnit": {
            "state": "translated",
            "value": "Beatavue saves workouts you explicitly start and stop on Apple Watch to Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchで開始・停止したワークアウトをヘルスケアに保存します。"
