{
  "firestore": {"rules": "infra/firestore.rules"},
  "emulators": {
    "firestore": {"host": "127.0.0.1", "port": 8081},
    "ui": {"enabled": false}
  },
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/v1/**", "run": {"serviceId": "beatavue-api", "region": "asia-northeast1"}},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'"}
      ]}
    ]
  }
}
